@model Customer

<section class="page-hero">
    <h1>@Model.Name</h1>
    <p>Detaljerad kundinformation</p>
</section>

<section class="page-section">
    <h2>Kundinformation</h2>

    <div class="customer-card">
        <p><strong>Avdelning:</strong> @Model.Department</p>
        <p><strong>Namn:</strong> @Model.Name</p>
        <p><strong>Email:</strong> @Model.Email</p>
        <p><strong>Telefon:</strong> @Model.Phone</p>
        <p><strong>Beskrivning:</strong> @Model.Description</p>
    </div>
</section>

<section class="page-section">
    <h2>Delete Kund</h2>
    <p>Är du säker på att du vill ta bort @Model.Name?</p>
    <form action="/Customer/Delete/@Model.Id" method="post">
        <button type="submit" class="btn btn-danger">Delete</button>
    </form>
</section>

<section class="page-section">
    <a href="/Customer/Show" class="btn btn-primary">Tillbaka till kundlista</a>
</section>