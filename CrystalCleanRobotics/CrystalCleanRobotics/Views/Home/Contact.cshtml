@{
    ViewData["Title"] = "Kontakta oss";
}


<section class="page-hero">
    <h1>@ViewData["Title"]</h1>
    <p>Vi finns här för att hjälpa dig – oavsett fråga eller behov.</p>
</section>


<section class="team-section">
    <h2>Vårt team</h2>

    <div class="team-strip">
        <div class="person">
            <p class="role">VD</p>
            <img src="~/content/img/personvd.png" alt="VD">
            <p class="name">John Doe</p>
           
        </div>

        <div class="person">
            <p class="role">Tekniker</p>
            <img src="~/content/img/person1.png" alt="Tekniker">
            <p class="name">Bob Johnson</p>
           
        </div>

        <div class="person">
            <p class="role">Säljare</p>
            <img src="~/content/img/person2.png" alt="Säljare">
            <p class="name">Jane Smith</p>
        </div>

        <div class="person">
            <p class="role">Administratör</p>
            <img src="~/content/img/person3.png" alt="Administratör">
            <p class="name">Alice Williams</p>
        </div>

        <div class="person">
            <p class="role">Marknadsförare</p>
            <img src="~/content/img/person4.png" alt="Marknadsförare">
            <p class="name">Emily Davis</p>
        </div>

        <div class="person">
            <p class="role">Kundtjänst</p>
            <img src="~/content/img/person5.png" alt="Kundtjänst">
            <p class="name">Charlie Brown</p>
        </div>
    </div>
</section>
<section class="customer-cases">
    <h2>Personal</h2>

    <div class="case">
        <h3>John Doe</h3>
        <p>
            John är företagets visionära ledare och den som driver CrystalClean Robotics framåt.
            Med lång erfarenhet inom automation och industriell innovation säkerställer han att varje projekt håller högsta kvalitet och att teamet alltid arbetar mot framtidens lösningar.
        </p>
    </div>

    <div class="case">
        <h3>Bob Johnson</h3>
        <p>
            Bob är en av våra mest erfarna tekniker och ansvarar för installation, service och felsökning av våra robotar.
            Han brinner för smart teknik och ser till att varje kund får en lösning som fungerar perfekt i deras miljö.
        </p>
    </div>

    <div class="case">
        <h3>Jane Smith</h3>
        <p>Jane är företagets ansikte utåt och hjälper kunder att hitta rätt robotlösning.
            Hon är lyhörd, kunnig och alltid redo att guida både företag och privatpersoner till den bästa produkten för deras behov.
        </p>
    </div>
    <div class="case">
        <h3>Alice Williams</h3>
        <p>
            Alice håller ordning på allt bakom kulisserna.
            Hon sköter planering, dokumentation och kundärenden med precision och ser till att företaget flyter på smidigt varje dag.
        </p>
    </div>
    <div class="case">
        <h3>Emily Davis</h3>
        <p>
            Emily ansvarar för företagets kommunikation och varumärke.
            Hon skapar kampanjer, uppdaterar hemsidan och ser till att CrystalClean Robotics syns på rätt sätt i rätt kanaler.
        </p>
    </div>
    <div class="case">
        <h3>Charlie Brown</h3>
        <p>
            Charlie är den som möter kunderna först och hjälper till med frågor, support och vägledning.
            Han är lugn, serviceinriktad och ser alltid till att kunden känner sig trygg och väl omhändertagen.
        </p>
    </div>
</section>


<section class="contact-card">
    <h2>Kontakta oss</h2>
    <p class="lead">Du är välkommen att höra av dig om du har frågor eller behöver hjälp.</p>

    <p><strong>Email:</strong> info@crystalcleanrobotics.com</p>
    <p><strong>Telefon:</strong> +46 123 456 789</p>
    <p><strong>Adress:</strong> Storgatan 1, 123 45 Stockholm, Sweden</p>
</section>
