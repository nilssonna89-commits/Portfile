@{
    ViewData["Title"] = "Products";
}


<section class="page-hero">
    <h1>Produkter</h1>
    <p>Utforska våra avancerade robotar – byggda för framtidens smarta rengöring.</p>
</section>


<section class="page-section">
    <h2>Våra produkter</h2>
    <p>CrystalClean Robotics erbjuder marknadens mest avancerade rengöringsrobotar med AI‑styrning, smart navigering och kraftfull prestanda.</p>

    <div class="product-grid">

        <div class="robot-card">
            <h3>Roborock</h3>
            <img src="~/content/img/Roborock.jpg" alt="Roborock">
            <ul>
                <li>Sugkraft: 20 000 Pa</li>
                <li>Navigering: RGB‑kamera + AI + 3D‑ljus</li>
                <li>Station: tömmer damm, fyller vatten, tvättar & torkar moppar</li>
                <li>Fördel: nästan helt självgående – premiumval</li>
            </ul>
        </div>

        <div class="robot-card">
            <h3>RobotDamsugare AI</h3>
            <img src="~/content/img/dammsugare2.png" alt="AI‑robot">
            <ul>
                <li>Sugkraft: 22 000 Pa</li>
                <li>Funktioner: dammtömning, 80° moppning, varmluftstorkning</li>
                <li>Teknik: ReactiveAI 3.0 + VertiBeam‑sensor</li>
                <li>Fördel: perfekt för mattor & hårda golv</li>
            </ul>
        </div>

        <div class="robot-card">
            <h3>RobotDamsugare Vit</h3>
            <img src="~/content/img/robotdamvit.jpg" alt="Vit robot">
            <ul>
                <li>Sugkraft: 6 000 Pa</li>
                <li>Navigering: LiDAR‑system</li>
                <li>Funktioner: moppning, appstyrning, låg ljudnivå</li>
                <li>Fördel: effektiv på djurhår & grus</li>
            </ul>
        </div>

        <div class="robot-card">
            <h3>Robot Assistent Extreme</h3>
            <img src="~/content/img/robotsugare.png" alt="Robot Extreme">
            <ul>
                <li>Sköter hela ditt hem automatiskt</li>
                <li>Sugkraft: 35 000 Pa</li>
                <li>Batteri: 6 400 mAh – upp till 220 min drift</li>
                <li>Funktioner: dammsugning, moppning, röststyrning</li>
                <li>Fördel: avancerad hinderigenkänning</li>
            </ul>
        </div>

    </div>
</section>
