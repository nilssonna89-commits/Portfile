@model List<Exercises>

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Workout</h4>
<form asp-controller="Workouts" asp-action="Create" method="post">

    <select name="ExercisesId">
        @foreach (Exercises exercise in Model)
        {
            <option value="@exercise.Id">@exercise.Name</option>
        }
    </select>

            <div class="form-group">
               <input type="text" name="name" placeholder="Name" />
               
            </div>

            <div class="form-group">
                <input type="datetime" name="Date" placeholder="Date" />
                <div class="form-group">
                    <input type="int" name="Repetitions" placeholder="Repetitions" />
                </div>
                <div class="form-group">
                    <input type="int" name="Sets" placeholder="Sets" />
                </div>
                <div class="form-group">
                    <input type="text" name="KM" placeholder="KM" />
                </div>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>

<div>
    <a asp-action="Index">Back to List</a>
</div>
